# Cloudflare Pages credentials. Copy to .env and fill in; .env is gitignored.
# Token: https://dash.cloudflare.com/profile/api-tokens (use the "Cloudflare Pages" template)
CLOUDFLARE_API_TOKEN=
# Account ID: run `npx wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=
# Pages project name  ->  https://<name>.pages.dev
CF_PAGES_PROJECT=heme-sap
# Directory to deploy
CF_PAGES_DIR=dist
