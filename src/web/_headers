/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# index.html has no content hash, so it must always be revalidated
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# course data must reflect a redeploy immediately; ETag still gives 304 on a hit
/course.json
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS filenames carry no hash, so a long cache would strand users on old styles.
# max-age=0 + must-revalidate still uses ETag: a hit costs one 304, not the payload.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# images and crawler files change rarely, so they can cache for a long time
/og.png
  Cache-Control: public, max-age=2592000

/llms.txt
  Cache-Control: public, max-age=86400
